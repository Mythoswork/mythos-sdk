{
  "name": "@mythos-work/sdk",
  "version": "0.3.0",
  "description": "Official Mythos SDK for Node.js — launch token verification, usage reporting, and handshake",
  "license": "Apache-2.0",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Mythoswork/mythos-sdk.git#main"
  },
  "main": "dist/index.js",
  "types": "dist/index.d.ts",
  "files": [
    "dist",
    "AGENTS.md",
    "skills"
  ],
  "bin": {
    "mythos-sdk": "dist/cli.js"
  },
  "exports": {
    ".": {
      "browser": "./dist/browser.js",
      "types": "./dist/index.d.ts",
      "require": "./dist/index.js",
      "default": "./dist/index.js"
    },
    "./client": {
      "types": "./dist/client.d.ts",
      "require": "./dist/client.js",
      "default": "./dist/client.js"
    },
    "./llm": {
      "types": "./dist/llm.d.ts",
      "require": "./dist/llm.js",
      "default": "./dist/llm.js"
    },
    "./next": {
      "types": "./dist/next.d.ts",
      "require": "./dist/next.js",
      "default": "./dist/next.js"
    },
    "./express": {
      "types": "./dist/express.d.ts",
      "require": "./dist/express.js",
      "default": "./dist/express.js"
    },
    "./react": {
      "types": "./dist/react.d.ts",
      "require": "./dist/react.js",
      "default": "./dist/react.js"
    },
    "./package.json": "./package.json"
  },
  "publishConfig": {
    "access": "public"
  },
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "build": "tsc && npm run build:global",
    "build:global": "esbuild src/client-global.ts --bundle --format=iife --global-name=Mythos --target=es2019 --minify --outfile=dist/mythos-client.global.js",
    "test": "jest",
    "prepublishOnly": "node ../../scripts/sync-agents.mjs && npm run build"
  },
  "dependencies": {
    "jose": "^5.0.0"
  },
  "peerDependencies": {
    "express": ">=4.0.0",
    "openai": "^6.49.0",
    "react": ">=18"
  },
  "peerDependenciesMeta": {
    "express": {
      "optional": true
    },
    "openai": {
      "optional": true
    },
    "react": {
      "optional": true
    }
  },
  "devDependencies": {
    "@types/express": "^4.17.0",
    "@types/jest": "^29.0.0",
    "@types/node": "^20.0.0",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "esbuild": "^0.28.2",
    "express": "^4.21.2",
    "jest": "^29.0.0",
    "openai": "^6.49.0",
    "react": "^19.3.0",
    "react-dom": "^19.3.0",
    "ts-jest": "^29.0.0",
    "typescript": "^5.0.0"
  },
  "jest": {
    "preset": "ts-jest",
    "testEnvironment": "node",
    "clearMocks": true
  },
  "directories": {
    "test": "tests"
  },
  "keywords": [],
  "author": "",
  "type": "commonjs",
  "bugs": {
    "url": "https://github.com/Mythoswork/mythos-sdk/issues"
  },
  "homepage": "https://github.com/Mythoswork/mythos-sdk/tree/main#readme"
}

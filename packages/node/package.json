{
  "name": "@mythos-work/sdk",
  "version": "0.1.1",
  "description": "Official Mythos SDK for Node.js — launch token verification, usage reporting, and handshake",
  "license": "Apache-2.0",
  "repository": {
    "type": "git",
    "url": "https://github.com/Mythoswork/mythos-sdk/tree/main/packages/node"
  },
  "main": "dist/index.js",
  "types": "dist/index.d.ts",
  "files": [
    "dist"
  ],
  "exports": {
    ".": {
      "browser": "./dist/browser.js",
      "require": "./dist/index.js",
      "default": "./dist/index.js",
      "types": "./dist/index.d.ts"
    },
    "./client": {
      "require": "./dist/client.js",
      "default": "./dist/client.js",
      "types": "./dist/client.d.ts"
    },
    "./llm": {
      "require": "./dist/llm.js",
      "default": "./dist/llm.js",
      "types": "./dist/llm.d.ts"
    },
    "./next": {
      "require": "./dist/next.js",
      "default": "./dist/next.js",
      "types": "./dist/next.d.ts"
    },
    "./package.json": "./package.json"
  },
  "publishConfig": {
    "access": "public"
  },
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "build": "tsc",
    "test": "jest",
    "prepublishOnly": "npm run build"
  },
  "dependencies": {
    "jose": "^5.0.0"
  },
  "peerDependencies": {
    "express": ">=4.0.0",
    "openai": "^6.49.0"
  },
  "peerDependenciesMeta": {
    "express": {
      "optional": true
    },
    "openai": {
      "optional": true
    }
  },
  "devDependencies": {
    "@types/express": "^4.17.0",
    "@types/jest": "^29.0.0",
    "@types/node": "^20.0.0",
    "express": "^4.21.2",
    "jest": "^29.0.0",
    "openai": "^6.49.0",
    "ts-jest": "^29.0.0",
    "typescript": "^5.0.0"
  },
  "jest": {
    "preset": "ts-jest",
    "testEnvironment": "node",
    "clearMocks": true
  }
}
